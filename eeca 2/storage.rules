rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'diretor'); }
    function validImage() { return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    match /news/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.auth.uid == uid && validImage();
      allow delete: if isAdmin();
    }
    match /complaint-evidence/{uid}/{fileName} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validImage();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
